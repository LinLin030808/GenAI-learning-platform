{
  "name": "sprout",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "vercel-build": "npm run db:migrate && npm run db:seed && next build",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@electric-sql/pglite": "0.5.10",
    "@neondatabase/serverless": "1.2.0",
    "@uiw/react-codemirror": "4.25.12",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
